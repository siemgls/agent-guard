{
  "name": "agent-guard",
  "version": "0.1.0",
  "description": "Drop-in dependency that spots AI agents (Claude in Chrome, Comet, Playwright) on course sites using behavioral signals.",
  "type": "module",
  "main": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./client.js": "./dist/client.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/client/index.ts --bundle --minify --format=iife --target=es2020 --outfile=dist/client.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "demo": "npm run build && node examples/express-quiz/server.mjs"
  },
  "keywords": [
    "ai-agent-detection",
    "bot-detection",
    "academic-integrity",
    "edtech",
    "express",
    "behavioral-analytics"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "express": ">=4"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "express": "^4.22.3",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3"
  }
}
